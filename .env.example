# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=karan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio
POSTGRES_ECHO=false

# Garage (dedicated bucket — do NOT reuse my-test-bucket)
GARAGE_ENDPOINT_URL=http://localhost:3900
GARAGE_ACCESS_KEY=change-me
GARAGE_SECRET_KEY=change-me
GARAGE_BUCKET_NAME=portfolio-media
GARAGE_REGION_NAME=garage

# SSO auth (karan_sso SDK) — see single_sign_on/backend/docs/SSO_CONTRACT.md §5
# Internal SSO API base (JWKS + live /auth/me are read from here)
SSO_BASE_URL=http://localhost:8000/api
# Public issuer; empty = don't check. Prod: https://auth.karanparmar.in/api/auth
SSO_ISSUER=
SSO_AUDIENCE=karanparmar-apps
# Set true once SSO sets JWT_AUDIENCE
SSO_REQUIRE_AUDIENCE=false
SSO_APP_ID=portfolio
# Legacy HS256 shared secret (= SSO JWT_SECRET) — rollout only; remove once SSO signs RS256
SSO_JWT_SECRET=
ACCESS_TOKEN_COOKIE_NAME=access_token
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
# production disables /docs, /redoc, /openapi.json and drops localhost CORS origins
ENVIRONMENT=development

# CORS — explicit origins; localhost entries are ignored when ENVIRONMENT=production
CORS_ALLOWED_ORIGINS=https://karanparmar.in,https://www.karanparmar.in,http://localhost:5174,http://localhost:4174

# Media limits
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_MAX_DOCUMENT_BYTES=10485760
MEDIA_ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/webp,image/svg+xml,image/avif
MEDIA_ALLOWED_DOCUMENT_TYPES=application/pdf
MEDIA_CACHE_MAX_AGE_SECONDS=31536000

# Legacy migration only (Phase 6)
LEGACY_POSTGRES_URL=postgresql+asyncpg://karan:change-me@localhost:5433/my_website
LEGACY_MONGO_URI=
LEGACY_MONGO_DB_NAME=my_website
